# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local file storage (prototype)
/storage

# throwaway screenshots from scripts/screenshots.mjs
scripts/shot-*.png

# Claude Code session artifacts
.claude/

# Stray file some Windows-shell commands accidentally create at repo root
# when a null-output redirect resolves to a literal "nul" instead of the
# actual null device — harmless, just keep it out of git.
/nul
